# Neon database connection string. NEON_DSN takes precedence when both are set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DSN=

# Google Sheets source and service-account credentials
SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SA_FILE=./bamboo-reports-service-account.json

# Upstash Redis credentials, used by the default ETL run (run.sh executes
# main_cache_purge.py) to purge the app's shared dashboard response cache
# after a successful import. Must match the app's deployment env. The purge
# is skipped when unset and never fails the import. With the app cache TTL
# set to 8 days, this purge is the mechanism that refreshes the dashboard
# after the weekly import, so set these in real environments.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
