# Neon database connection string. NEON_DSN takes precedence when both are set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DSN=

# Google Sheets source and service-account credentials
SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SA_FILE=./bamboo-reports-service-account.json

# Optional, only used by main_cache_purge.py: purge the app's shared dashboard
# response cache (Upstash Redis) after a successful import. Same values as the
# app's deployment env. Skipped when unset.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
