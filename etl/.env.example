# One .env for every ETL tool (importer, sheets.validate, sheets.cleanup).
# Copy to etl/.env and fill in.

# Neon connection strings, one per target. The importer picks one with
# --target dev|prod (default dev), so prod is only written when named.
DATABASE_URL_DEV=postgresql://user:password@dev-host/dbname?sslmode=require
DATABASE_URL_PROD=postgresql://user:password@prod-host/dbname?sslmode=require

# Google Sheets source and service-account key (absolute, or relative to etl/)
SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SA_FILE=bamboo-reports-service-account.json

# Upstash Redis credentials, used to purge the app's shared dashboard
# response cache after a successful --target prod import (dev imports and
# --no-purge skip it). Must match the app's deployment env. The purge is
# skipped when unset and never fails the import. With the app cache TTL set
# to 8 days, this purge is what refreshes the dashboard after the weekly
# import, so set these in real environments.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
